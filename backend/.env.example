# MongoDB (on Railway: ${{MongoDB.MONGO_URL}})
MONGO_URL=mongodb://localhost:27017
DB_NAME=lakeze_platform

# At least 32 characters
JWT_SECRET=

# Comma-separated allowed frontend origins; "*" allows all
CORS_ORIGINS=*

# Public URL of the frontend app
APP_URL=https://manager.lakeze.com

# Point at a Railway volume mount so uploads survive redeploys
UPLOAD_DIR=/data/uploads

# API keys: loaded from Notion if set, otherwise from these env vars
NOTION_API_KEY=
NOTION_PAGE_ID=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# PMS relay proxy (DigitalOcean droplet with fixed IP); overrides per-venue values
PMS_PROXY_URL=
PMS_PROXY_API_KEY=

# Only used when the database has no users: creates the first admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
